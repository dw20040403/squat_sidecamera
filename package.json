{
  "name": "squat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "setup:assets": "node scripts/fetch-assets.mjs",
    "setup:certs": "bash scripts/setup-certs.sh",
    "dev": "npm run dev -w server",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "vitest run tests/report",
    "test:e2e": "playwright test --trace off",
    "typecheck": "tsc -p web --noEmit && tsc -p server --noEmit && tsc -p tests --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
